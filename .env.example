# PostgreSQL 17. Keep credentials out of the repository.
DATABASE_URL=postgresql+psycopg://harvest:change-me@127.0.0.1:5432/harvest

# Alibaba Cloud Model Studio (Beijing). Leave empty until P1 is ready for real API validation.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_TTS_MODEL=qwen-audio-3.0-tts-plus
# Leave empty until a Japanese-capable base/cloned voice is selected in /settings.
DASHSCOPE_TTS_VOICE=
DASHSCOPE_ASR_MODEL=fun-asr
DASHSCOPE_ASR_POLL_SECONDS=2
DASHSCOPE_ASR_TIMEOUT_SECONDS=900

# Reserved for P3. Never place this key in the iOS app.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# 所有文本问答统一优先使用 Max 免费额度；耗尽后再填 DEEPSEEK_API_KEY 作为备用。
DASHSCOPE_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen3.7-max
LLM_PROVIDER=auto
LLM_FALLBACK_ON_ERROR=true
DASHSCOPE_OMNI_MODEL=qwen3.5-omni-flash-realtime
# Requires the Bailian workspace ID, for example:
# wss://WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
DASHSCOPE_OMNI_WS_URL=
DASHSCOPE_OMNI_VOICE=Ethan
# 可选：只填写不与正式教学提示词冲突的语音会话补充要求。
DASHSCOPE_OMNI_INSTRUCTIONS=
DASHSCOPE_VL_MODEL=qwen-vl-plus

# Alibaba Cloud OSS delivery bucket. OSS_PUBLIC_BASE_URL must be reachable by iPhone.
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=
# Applied from the backend settings page. Delivery media under materials/ is never matched.
OSS_TEMPORARY_RETENTION_DAYS=1
OSS_SHADOWING_RETENTION_DAYS=7
OSS_UPLOAD_TIMEOUT_SECONDS=90
OSS_UPLOAD_MAX_ATTEMPTS=4

# The private control-plane address shown by start.sh, for example harvest.tailnet-name.ts.net.
TAILSCALE_HOSTNAME=

# Local video-ingest safeguards. Byte counts: 2 GB maximum, 5 GB free-space reserve.
MAX_VIDEO_UPLOAD_BYTES=2000000000
MAX_PHOTO_UPLOAD_BYTES=20000000
MAX_AUDIO_UPLOAD_BYTES=25000000
MIN_FREE_DISK_BYTES=5000000000
# What gets fetched from a link, and how many threads may transcode it.
VIDEO_DOWNLOAD_MAX_HEIGHT=720
VIDEO_DOWNLOAD_MAX_FPS=30
VIDEO_TRANSCODE_MAX_THREADS=2
# What gets delivered to the phone. Separate from the fetch limits above so the source we
# cut from can stay better than the stream. 480p/600k puts a 27-minute section near 146MB
# (720p/1500k made it 252MB, ~30 minutes to publish at this machine's ~145 KB/s uplink).
VIDEO_HLS_MAX_HEIGHT=480
VIDEO_HLS_VIDEO_BITRATE_KBPS=600

# Optional local dependency for extracting speech from videos with background music:
#   ./.venv/bin/pip install -e '.[voice]'
# The htdemucs model is downloaded on the first video voice-enrollment job.
